{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nori.local/schemas/persona-simulation.schema.json",
  "title": "Nori Real-Life Persona Simulation Schema",
  "description": "Schema definitions for profile.json and month.json in sim/personas/<slug>/.",
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "email",
        "timezone",
        "sim_start_date",
        "presets",
        "preferences",
        "persona_responder_brief",
        "mcp_world"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[0-9]{2}-[a-z0-9-]+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "timezone": { "type": "string", "minLength": 1 },
        "locale": { "type": "string" },
        "sim_start_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["smoke", "memory-pack", "full"]
          },
          "minItems": 1
        },
        "summary": { "type": "string" },
        "feature_focus": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preferences": {
          "type": "object",
          "properties": {
            "timezone": { "type": "string" },
            "locale": { "type": "string" },
            "budget_per_task_usd": { "type": "number", "minimum": 0.1 },
            "monthly_limit_usd": { "type": ["number", "null"], "minimum": 1 },
            "working_hours": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": { "type": "boolean" },
                  "start": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
                  "end": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" }
                },
                "required": ["enabled"]
              }
            }
          }
        },
        "initial_permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "effect", "tool_names"],
            "properties": {
              "title": { "type": "string" },
              "effect": { "type": "string", "enum": ["allow", "deny"] },
              "tool_names": {
                "type": "array",
                "items": { "type": "string" }
              },
              "recipients": {
                "type": "array",
                "items": { "type": "string" }
              },
              "action_classes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "max_operations": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "persona_responder_brief": {
          "type": "string",
          "minLength": 40
        },
        "mcp_world": {
          "type": "object",
          "properties": {
            "server_name": { "type": "string" },
            "emails": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "from", "to", "subject", "date", "body"],
                "properties": {
                  "id": { "type": "string" },
                  "from": { "type": "string" },
                  "to": { "type": "array", "items": { "type": "string" } },
                  "subject": { "type": "string" },
                  "date": { "type": "string" },
                  "body": { "type": "string" },
                  "folder": { "type": "string" },
                  "untrusted": { "type": "boolean" }
                }
              }
            },
            "calendar_events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "start", "end"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "start": { "type": "string" },
                  "end": { "type": "string" },
                  "location": { "type": "string" },
                  "attendees": { "type": "array", "items": { "type": "string" } },
                  "notes": { "type": "string" }
                }
              }
            },
            "docs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "content"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "updated_at": { "type": "string" },
                  "tags": { "type": "array", "items": { "type": "string" } },
                  "content": { "type": "string" }
                }
              }
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "status"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "status": { "type": "string" },
                  "assignee": { "type": "string" },
                  "priority": { "type": "string" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "month": {
      "type": "object",
      "required": ["persona", "sim_start_date", "events"],
      "additionalProperties": false,
      "properties": {
        "persona": { "type": "string" },
        "sim_start_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end_of_month_audit": {
          "type": "object",
          "properties": {
            "expected_core_concepts": {
              "type": "array",
              "items": { "type": "string" }
            },
            "forbidden_core_substrings": {
              "type": "array",
              "items": { "type": "string" }
            },
            "expected_daily_log_topics": {
              "type": "array",
              "items": { "type": "string" }
            },
            "rubric": { "type": "string" }
          }
        },
        "events": {
          "type": "array",
          "minItems": 35,
          "items": {
            "type": "object",
            "required": ["id", "day", "local_time", "kind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "day": { "type": "integer", "minimum": 1, "maximum": 31 },
              "local_time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
              "timezone": { "type": "string" },
              "kind": {
                "type": "string",
                "enum": [
                  "chat",
                  "settle",
                  "memory_ui",
                  "preferences_ui",
                  "permission_ui",
                  "automation_ui",
                  "goal_ui",
                  "library_ui",
                  "interaction_reply",
                  "mcp_world_event"
                ]
              },
              "text": { "type": "string" },
              "attachments": {
                "type": "array",
                "items": { "type": "string" }
              },
              "wait_for_reply": { "type": "boolean" },
              "interrupt_active": { "type": "boolean" },
              "action": { "type": "string" },
              "params": { "type": "object" },
              "snapshot_label": { "type": "string" },
              "assert_invariants": {
                "type": "array",
                "items": { "type": "string" }
              },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "probe": {
                "type": "object",
                "required": ["id", "category", "rubric"],
                "properties": {
                  "id": { "type": "string" },
                  "category": { "type": "string" },
                  "rubric": { "type": "string", "minLength": 20 },
                  "must_not_contain_in_core": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "expect_fts_query": {
                    "type": "object",
                    "required": ["query", "min_hits"],
                    "properties": {
                      "query": { "type": "string" },
                      "layer": { "type": "string", "enum": ["", "core", "log"] },
                      "min_hits": { "type": "integer", "minimum": 0 },
                      "max_hits": { "type": "integer", "minimum": 0 }
                    }
                  },
                  "expect_no_external_write": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    }
  }
}
