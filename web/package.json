{
  "name": "nori-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build && bun build --production --target=node --format=esm --outfile=.next/standalone/ws-server.mjs ws-server.mjs",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "bun test src",
    "api:types": "openapi-typescript ../api/openapi.yaml -o src/lib/contracts/openapi.d.ts",
    "api:types:check": "bun -e 'import { execFileSync } from \"node:child_process\"; import { readFileSync } from \"node:fs\"; const generated = execFileSync(\"./node_modules/.bin/openapi-typescript\", [\"../api/openapi.yaml\"], { encoding: \"utf8\" }); const current = readFileSync(\"src/lib/contracts/openapi.d.ts\", \"utf8\"); if (generated !== current) { console.error(\"web/src/lib/contracts/openapi.d.ts is stale. Run: make api-types\"); process.exit(1); }'",
    "contracts": "bun run api:types",
    "contracts:check": "bun run api:types:check",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@sentry/nextjs": "11.18.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.61.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "motion": "^14.6.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sentry/bun": "11.18.0",
    "@tailwindcss/turbopack": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "typescript-eslint": "8.74.0"
  }
}
