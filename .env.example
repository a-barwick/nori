# aws selects S3, SQS, Secrets Manager, EC2/SSM and signed service calls.
# local uses loopback services.
NORI_CLOUD=gcp
# AWS SDK uses workload IAM roles or the ordinary AWS credential chain.
AWS_REGION=
# Use a standard SQS queue.
NORI_AWS_WAKE_QUEUE_URL=
# Shared only by trusted web, API, worker and wake consumer; at least 32 random bytes.
NORI_SERVICE_TOKEN_KEY=
NORI_SERVICE_AUDIENCE=nori
# Sign-in defaults to iap on gcp and oidc otherwise; optional explicit override.
# NORI_AUTH_PROVIDER=oidc
NORI_OIDC_ISSUER=
NORI_OIDC_AUDIENCE=
# Optional secure, HttpOnly ID-token cookie supplied by an OIDC login gateway.
# Otherwise the web server reads Authorization: Bearer <ID token>.
NORI_OIDC_COOKIE=

# Local configuration for both core and web. New project keys belong in root .env.
# Select existing credential files in place; never copy credentials into this example.
# Core reads every setting once at startup (core/internal/settings). An empty value means unset.

# Path to the configuration file to load, for launching from a worktree. Default ../.env.
# NORI_ENV_FILE=/absolute/path/to/nori/.env
# A separate task configuration loaded after NORI_ENV_FILE. Defaults to NORI_ENV_FILE.
# NORI_TASK_ENV_FILE=/absolute/path/to/nori/.env

# Outer conversation key, OpenAI platform API, low reasoning and standard tier.
OPENAI_API_KEY=
# Task worker and conversation summary key, OpenRouter Responses.
OPENROUTER_API_KEY=
# Intent classifier key.
JEV_API_KEY=
# Outer conversation model.
NORI_AGENT_MODEL=gpt-6.1-sol
# Task worker model.
MODEL_NAME=openai/gpt-6.1-terra

# Optional assistant parts; all default to true. False background tasks selects
# chat-only mode: no Temporal connection, worker, Jev or OpenRouter key is required.
# Retained assistant work stays saved until re-enabled. Model roles never change.
NORI_BACKGROUND_TASKS_ENABLED=true
NORI_JEV_ENABLED=true
NORI_COMPUTER_ENABLED=true

# Model usage. Durable local records always remain enabled.
NORI_USAGE_METER=store
# Set the meter to http to also send usage metadata to a host endpoint.
# HTTPS is required except on loopback. The host upserts by user_id and usage.id.
NORI_USAGE_ENDPOINT=
NORI_USAGE_TOKEN=

# Without this key, web_search reports itself unavailable.
BRAVE_SEARCH_API_KEY=
# Time zone and computer are stored in users rows. Provision with core/cmd/nori-user.

# Address the hosted API binds to. The local entrypoint always binds 127.0.0.1.
BIND_HOST=127.0.0.1
# API port, default 8080. On the worker, setting it serves wake requests; leaving it empty polls.
PORT=8080

# Storage. Defaults: Firestore on gcp, Postgres on aws/local. Explicit override:
# NORI_STORE_BACKEND=firestore
# Postgres connection string, kept in this private env file. Local make deps:
# NORI_POSTGRES_URL=postgres://nori@127.0.0.1:15432/nori?sslmode=disable
# Google APIs use Application Default Credentials.
# Google Cloud project. Required for Firestore, with no default.
NORI_PROJECT_ID=
# Firestore database. Required for Firestore, with no default.
FIRESTORE_DATABASE_ID=
# Cloud Storage or S3 bucket for file bytes, selected by NORI_CLOUD.
ARTIFACT_BUCKET=
# Loopback Firestore emulator for the whole process, for local development.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Loopback Firestore emulator for app data.
# NORI_STATE_EMULATOR_HOST=127.0.0.1:8085
# Local folder for file bytes instead of the bucket. Needs a loopback database and TEMPORAL_LOCAL=true.
# NORI_LOCAL_ARTIFACT_DIR=/absolute/path

# GCP uses Cloud Tasks, AWS uses SQS, and local mode uses its own wake loop.
# API root for conversation wakes. On GCP Agent Runtime this ends in /api/.
NORI_RUNTIME_URL=
# Cloud Tasks queue for conversation wakes.
NORI_WAKE_QUEUE=
# Service account that signs every wake.
NORI_WAKE_SERVICE_ACCOUNT=
# JSON map of immutable worker build to service root URL. Required with a route for this build when worker PORT is set; otherwise workers can poll.
NORI_WORKER_SERVICES=
# Cloud Tasks queue for worker wakes.
NORI_WORKER_WAKE_QUEUE=
# Loopback Cloud Tasks emulator for local runs.
# CLOUD_TASKS_EMULATOR_HOST=127.0.0.1:8123

# Use a namespace-scoped API key for TLS to Temporal Cloud.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# Secret reference takes precedence over the key: GCP version path or AWS Secrets Manager name/ARN.
# Local mode has no secret store; use the env file value.
# TEMPORAL_API_KEY_SECRET_VERSION=projects/bot-111549/secrets/nori-temporal-api-key/versions/1
# Task queue workflows and workers share.
TEMPORAL_TASK_QUEUE=nori-tasks
# Worker deployment name. Required when worker PORT is set; polling workers default to nori-task.
TEMPORAL_DEPLOYMENT_NAME=nori-task
# Immutable build/release ID; change it for each worker release.
TEMPORAL_BUILD_ID=
# true only for an explicitly local development server (no TLS/API key).
TEMPORAL_LOCAL=false
# Worker image sets this true; leave false for the API and local processes.
TEMPORAL_CLOUD_RUN_ID=false
# Request-bound worker poll window, a Go duration up to 240s.
NORI_WORKER_POLL_WINDOW=240s
# Request-bound worker idle window, a Go duration.
NORI_WORKER_IDLE_WINDOW=15s

# Model/tool spending ceiling for each new background task and its subtasks, in USD.
# Checked between calls; unreported costs remain unknown. Reaching it ends the task incomplete.
NORI_TASK_BUDGET_USD=1
# Select production or sandbox resources in operator commands.
NORI_ENVIRONMENT=

# Configure Sentry account quotas and Arize limits separately from the process-local limits below.
# Sentry project DSN for core.
SENTRY_DSN=
# Sentry environment. Default development, or production on Cloud Run.
SENTRY_ENVIRONMENT=development
# Sentry release. Default the Cloud Run revision, then TEMPORAL_BUILD_ID.
SENTRY_RELEASE=
# Share of traces sampled, 0 to 1.
SENTRY_TRACES_SAMPLE_RATE=0.05
NORI_SENTRY_ERRORS_PER_HOUR=50
NORI_SENTRY_LOGS_PER_HOUR=100
NORI_SENTRY_METRICS_PER_HOUR=200
# Arize space ID; export needs it and the key.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=nori
# Canonical Arize project page; enables generated links on Sentry model spans.
ARIZE_PROJECT_URL=
# Optional alternate HTTPS OTLP traces endpoint, e.g. the Arize EU endpoint.
ARIZE_OTLP_ENDPOINT=
# PEM file of a collector CA trusted for Arize only.
ARIZE_OTLP_CERTIFICATE=
# Approved model prompt/reply text is opt-in, redacted, and bounded.
NORI_ARIZE_CAPTURE_CONTENT=false
# Cloud Run sets K_SERVICE and K_REVISION itself; core reads them for the environment and release.

# Local agent API for the web server; enabled by make dev and ignored in production.
NORI_LOCAL_AGENT_URL=http://127.0.0.1:8080
# /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
IAP_AUDIENCE=
# Optional canonical HTTPS origin for a custom domain.
NORI_APP_ORIGIN=
# Web public values are baked into the Next build. The source-map token is
# build-only; Docker accepts it as the BuildKit secret sentry_auth_token.
NEXT_PUBLIC_SENTRY_DSN=
# Optional Next.js server/edge override; otherwise uses NEXT_PUBLIC_SENTRY_DSN.
SENTRY_WEB_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Verified identity for loopback web development; must match a provisioned user email.
NORI_LOCAL_EMAIL=

# Push and email delivery destinations (optional; unset leaves the channel without a transport).
# Web Push VAPID keys: base64url P-256 public point and private scalar; subject is mailto: or https:.
NORI_VAPID_PUBLIC_KEY=
NORI_VAPID_PRIVATE_KEY=
NORI_VAPID_SUBJECT=
# Any SMTP relay with STARTTLS (587) or implicit TLS (465).
NORI_SMTP_HOST=
NORI_SMTP_PORT=
NORI_SMTP_USERNAME=
NORI_SMTP_PASSWORD=
NORI_EMAIL_FROM=

# Google (Calendar, Gmail, Contacts, Drive) OAuth web client from Google Cloud Console; its redirect URIs must include
# NORI_OAUTH_REDIRECT_URL. Without the pair, Google shows as not configured in Apps.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# OAuth callback every provider redirects to, through the web proxy (local: http://127.0.0.1:<web port>/api/v1/connections/oauth/callback).
NORI_OAUTH_REDIRECT_URL=

# Microsoft (Outlook calendar, mail, contacts): Entra app registration allowing personal and work/school accounts,
# with NORI_OAUTH_REDIRECT_URL as a Web redirect URI.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (default), consumers (personal Microsoft accounts only) or organizations.
MICROSOFT_TENANT=
# Local development only (requires NORI_CLOUD=local): a PEM root the push and email transports also trust, for
# verifying delivery against local sinks with self-signed certificates.
NORI_DELIVERY_TEST_CA_FILE=
# Local stack only: send every model request to an http loopback stub (for example http://127.0.0.1:18990), for
# checking model timeouts and prompts without provider keys. Startup refuses it unless NORI_CLOUD=local.
NORI_MODEL_TEST_URL=

# Connected-account credentials (D1): NORI_CREDENTIAL_STORE=database keeps envelope-encrypted rows in the database;
# data keys are wrapped by NORI_CREDENTIAL_KMS_KEY (a Cloud KMS key resource name) or, on the local stack only,
# NORI_CREDENTIAL_KEY_FILE (a 32-byte master key file, created with mode 600 if missing). NORI_CREDENTIAL_STORE=local
# keeps the development file vault.
NORI_CREDENTIAL_STORE=
NORI_CREDENTIAL_KMS_KEY=
NORI_CREDENTIAL_KEY_FILE=
