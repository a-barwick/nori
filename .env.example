NORI_ENV_FILE=
NORI_TASK_ENV_FILE=

# NORI_CLOUD: local (default for nori-local), gcp (native GCS via ADC), or aws (S3 + AWS Secrets Manager)
NORI_CLOUD=local
NORI_ROLE=all
# AWS_REGION is only used when NORI_CLOUD=aws
AWS_REGION=
NORI_SERVICE_TOKEN_KEY=
NORI_SERVICE_AUDIENCE=nori

# Authentication & user provisioning
NORI_AUTH_PROVIDER=oidc
NORI_OIDC_ISSUER=
NORI_OIDC_AUDIENCE=
NORI_OIDC_COOKIE=
# NORI_USER_PROVISIONING: manual (default), invite, or open
NORI_USER_PROVISIONING=manual
NORI_ALLOWED_EMAILS=
NORI_GOOGLE_OAUTH_CLIENT_IDS=

# Storage (Postgres + GCS/S3/localfs artifacts)
NORI_STORE_BACKEND=postgres
NORI_POSTGRES_URL=
NORI_POSTGRES_LISTEN_URL=
NORI_POSTGRES_MAX_CONNS=
NORI_POSTGRES_MIN_CONNS=
NORI_POSTGRES_MAX_CONN_LIFETIME=
NORI_POSTGRES_MAX_CONN_IDLE_TIME=
NORI_POSTGRES_HEALTH_CHECK_PERIOD=
NORI_POSTGRES_STATEMENT_TIMEOUT=
ARTIFACT_BUCKET=
NORI_LOCAL_ARTIFACT_DIR=

# Models, local Inkling dev server, and loopback test overrides
# Hosted deployments require BYOK user keys configured in More -> Models.
# For local development and tests, point to local Ollama running Inkling Mini 2:
#   NORI_LOCAL_MODEL_URL=http://127.0.0.1:11434
#   NORI_LOCAL_MODEL_TAG=inkling-2-mini
NORI_ENV_PROFILE=dev
NORI_LOCAL_MODEL_URL=
NORI_LOCAL_MODEL_TAG=
NORI_BYOK_REQUIRED=
NORI_MODEL_PROVIDER=
NORI_OUTER_PROVIDER=
NORI_INNER_PROVIDER=
NORI_AGENT_MODEL=
MODEL_NAME=
NORI_OUTER_REASONING_EFFORT=
NORI_INNER_REASONING_EFFORT=
NORI_MODEL_PROFILES=
NORI_MODEL_PROFILES_FILE=
NORI_MODEL_TEST_URL=

JEV_API_KEY=
NORI_LLM_MAX_USD=

NORI_BACKGROUND_TASKS_ENABLED=true
NORI_JEV_ENABLED=true
NORI_TASK_BUDGET_USD=1

# Usage metering & per-user guardrails (defaults: 300 calls/hr, $15/day)
NORI_USAGE_METER=store
NORI_USAGE_ENDPOINT=
NORI_USAGE_TOKEN=
NORI_USER_MAX_CALLS_PER_HOUR=300
NORI_USER_MAX_USD_PER_DAY=15

EXA_API_KEY=

# Credentials, MCP, and permissions
NORI_OAUTH_REDIRECT_URL=
NORI_CREDENTIAL_STORE=database
NORI_CREDENTIAL_KMS_KEY=
NORI_CREDENTIAL_KEY=
NORI_CREDENTIAL_KEY_SECRET=
NORI_CREDENTIAL_KEY_FILE=
NORI_MCP_COMMANDS=
NORI_AUTOMATION_UNATTENDED=confirm_writes
NORI_USER_SENDS=ask

# Home AI Server (Core & connector relay)
NORI_HOME_AI_KEY=
NORI_HOME_AI_VERIFY_URL=
NORI_HOME_AI_POSTGRES_URL=
NORI_HOME_AI_POSTGRES_LISTEN_URL=
NORI_HOME_AI_WORK_ENABLED=false
NORI_HOME_AI_DOWNLOAD_MACOS=
NORI_HOME_AI_DOWNLOAD_LINUX_AMD64=
NORI_HOME_AI_DOWNLOAD_LINUX_ARM64=

# Optional Google connection. Set the client ID, secret and redirect URL on Core only.
# NORI_GOOGLE_WORKSPACE_TEST_USERS limits Google to these sign-in emails. Leave it empty to offer Google to every user.
NORI_GOOGLE_WORKSPACE_CLIENT_ID=
NORI_GOOGLE_WORKSPACE_CLIENT_SECRET=
NORI_GOOGLE_WORKSPACE_REDIRECT_URL=
NORI_GOOGLE_WORKSPACE_TEST_USERS=

# HTTP rate limiting (optional overrides)
NORI_RATE_LIMIT_ENABLED=true
NORI_RATE_LIMIT_READ_PER_MIN=
NORI_RATE_LIMIT_READ_BURST=
NORI_RATE_LIMIT_WRITE_PER_MIN=
NORI_RATE_LIMIT_WRITE_BURST=
NORI_RATE_LIMIT_UPLOAD_PER_MIN=
NORI_RATE_LIMIT_UPLOAD_BURST=
NORI_RATE_LIMIT_RESOLVE_PER_MIN=
NORI_RATE_LIMIT_RESOLVE_BURST=
NORI_RATE_LIMIT_MAX_CONCURRENT_SSE=
NORI_RATE_LIMIT_MAX_ENTRIES=
NORI_RATE_LIMIT_IDLE_TTL=

# Server bind & Web runtime
BIND_HOST=127.0.0.1
PORT=8080

NORI_RUNTIME_URL=
NORI_LOCAL_AGENT_URL=http://127.0.0.1:8080
NORI_APP_ORIGIN=
NORI_LOCAL_EMAIL=

# Observability (Core, Web, and iOS)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
NORI_SENTRY_ERRORS_PER_HOUR=50
NORI_SENTRY_LOGS_PER_HOUR=100
NORI_SENTRY_METRICS_PER_HOUR=200
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=nori
ARIZE_PROJECT_URL=
ARIZE_OTLP_ENDPOINT=
ARIZE_OTLP_CERTIFICATE=
NORI_ARIZE_CAPTURE_CONTENT=false

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_WEB_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# iOS Sentry settings for CI and scripts/upload-ios-dsyms.sh. See ios/README.md.
SENTRY_IOS_DSN=
SENTRY_PROJECT_IOS=nori-ios
