# Configuration for both core and web. New project keys belong in root .env.
# Select existing credential files in place; never copy credentials into this example.
# Core reads every setting once at startup (core/internal/settings). An empty value means unset.

# Path to the configuration file to load, for launching from a worktree. Default ../.env.
# NORI_ENV_FILE=/absolute/path/to/nori/.env
# A separate task configuration loaded after NORI_ENV_FILE. Defaults to NORI_ENV_FILE.
# NORI_TASK_ENV_FILE=/absolute/path/to/nori/.env

# Cloud mode: aws (S3, Secrets Manager, signed service calls) or local (loopback services).
# Hosted entrypoints default to aws; cmd/nori-local defaults to local.
NORI_CLOUD=local
# Single-binary runtime role for cmd/nori (--role flag overrides): all (default), api, or worker.
NORI_ROLE=all
# AWS SDK uses workload IAM roles or the ordinary AWS credential chain.
AWS_REGION=
# Shared only by trusted web and API; at least 32 random bytes.
NORI_SERVICE_TOKEN_KEY=
NORI_SERVICE_AUDIENCE=nori

# Hosted OIDC sign-in for the web server (defaults to oidc).
NORI_AUTH_PROVIDER=oidc
NORI_OIDC_ISSUER=
NORI_OIDC_AUDIENCE=
# Optional secure, HttpOnly ID-token cookie supplied by an OIDC login gateway.
# Otherwise the web server reads Authorization: Bearer <ID token>.
NORI_OIDC_COOKIE=

# Storage: Postgres is the sole database and durability backend (nori_records + nori_task_leases + nori_user_wakes).
NORI_STORE_BACKEND=postgres
# Postgres connection string, kept in this private env file. Local make deps:
# NORI_POSTGRES_URL=postgres://nori@127.0.0.1:15432/nori?sslmode=disable
NORI_POSTGRES_URL=
# Optional direct Postgres URL for dedicated LISTEN/NOTIFY connections when NORI_POSTGRES_URL routes
# through RDS Proxy or PgBouncer transaction pooling. Defaults to NORI_POSTGRES_URL.
NORI_POSTGRES_LISTEN_URL=
# Optional pgxpool and query tuning (empty uses URL query params if set, otherwise backend defaults):
# Defaults: MAX_CONNS=25, MIN_CONNS=2, MAX_CONN_LIFETIME=30m, MAX_CONN_IDLE_TIME=5m,
# HEALTH_CHECK_PERIOD=30s, STATEMENT_TIMEOUT=30s (Go durations for time settings).
NORI_POSTGRES_MAX_CONNS=
NORI_POSTGRES_MIN_CONNS=
NORI_POSTGRES_MAX_CONN_LIFETIME=
NORI_POSTGRES_MAX_CONN_IDLE_TIME=
NORI_POSTGRES_HEALTH_CHECK_PERIOD=
NORI_POSTGRES_STATEMENT_TIMEOUT=
# Private S3 bucket for file bytes when NORI_CLOUD=aws.
ARTIFACT_BUCKET=
# Local folder for file bytes when NORI_CLOUD=local. Needs a loopback Postgres database.
# NORI_LOCAL_ARTIFACT_DIR=/absolute/path

# Outer conversation key, OpenAI platform API, low reasoning and standard tier.
OPENAI_API_KEY=
# Task worker and conversation summary key, OpenRouter Responses.
OPENROUTER_API_KEY=
# Intent classifier key.
JEV_API_KEY=
# Outer conversation model.
NORI_AGENT_MODEL=gpt-6.1-sol
# Task worker model.
MODEL_NAME=openai/gpt-6.1-terra

# Optional deployment-owned OpenAI-compatible model gateway. Set provider to gateway and set both model aliases
# above explicitly. The URL is the HTTPS API base, including its version prefix (e.g. https://models.example.invalid/v1).
# Inject the raw bearer token into both processes through the deployment's secret manager.
NORI_MODEL_PROVIDER=
NORI_MODEL_GATEWAY_URL=
NORI_MODEL_GATEWAY_API_KEY=
# Local stack only: send every model request to an http loopback stub (for example http://127.0.0.1:18990), for
# checking model timeouts and prompts without provider keys. Startup refuses it unless NORI_CLOUD=local.
NORI_MODEL_TEST_URL=

# Optional assistant features; both default to true. False background tasks selects
# chat-only mode: no Jev or OpenRouter key is required.
NORI_BACKGROUND_TASKS_ENABLED=true
NORI_JEV_ENABLED=true

# Model/tool spending ceiling for each new background task and its subtasks, in USD.
NORI_TASK_BUDGET_USD=1

# Model usage metering. Durable local records always remain enabled.
NORI_USAGE_METER=store
# Set the meter to http to also send usage metadata to a host endpoint (HTTPS required except on loopback).
NORI_USAGE_ENDPOINT=
NORI_USAGE_TOKEN=

# Without this key, web_search reports itself unavailable.
BRAVE_SEARCH_API_KEY=

# Connections, MCP servers, and encrypted credential rows (D1).
# OAuth callback through the web proxy (local: http://127.0.0.1:<web port>/api/v1/connections/oauth/callback).
NORI_OAUTH_REDIRECT_URL=
# NORI_CREDENTIAL_STORE=database keeps AES-256-GCM envelope-encrypted rows in Postgres (AAD bound to owner:connectionID).
# Master key options:
# - NORI_CREDENTIAL_KEY: 32-byte key encoded as 64 hex chars or base64.
# - NORI_CREDENTIAL_KEY_SECRET: AWS Secrets Manager secret name/ARN holding the 32-byte key (when NORI_CLOUD=aws).
# - NORI_CREDENTIAL_KEY_FILE: 32-byte master key file, created mode 600 if missing (local development only, NORI_CLOUD=local).
NORI_CREDENTIAL_STORE=
NORI_CREDENTIAL_KEY=
NORI_CREDENTIAL_KEY_SECRET=
NORI_CREDENTIAL_KEY_FILE=
# Local development only (NORI_CLOUD=local): JSON map of command_ref to argv array for stdio MCP servers.
NORI_MCP_COMMANDS=
# Interim permission policies: confirm_writes (default) or require_rule; allow (default) or ask.
NORI_AUTOMATION_UNATTENDED=confirm_writes
NORI_USER_SENDS=allow

# Address the hosted API binds to. The local entrypoint always binds 127.0.0.1.
BIND_HOST=127.0.0.1
PORT=8080

# Hosted HTTPS Go runtime base URL for the web server (when NORI_CLOUD=aws).
NORI_RUNTIME_URL=
# Local agent API for the web server; enabled by make dev and ignored in production.
NORI_LOCAL_AGENT_URL=http://127.0.0.1:8080
# Optional canonical HTTPS origin for a custom domain.
NORI_APP_ORIGIN=
# Verified identity for loopback web development; must match a provisioned user email.
NORI_LOCAL_EMAIL=

# Observability (Sentry + Arize OTLP). Configure account quotas separately from the process-local limits below.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
NORI_SENTRY_ERRORS_PER_HOUR=50
NORI_SENTRY_LOGS_PER_HOUR=100
NORI_SENTRY_METRICS_PER_HOUR=200
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=nori
# Canonical Arize project page; enables generated links on Sentry model spans.
ARIZE_PROJECT_URL=
# Optional alternate HTTPS OTLP traces endpoint, e.g. the Arize EU endpoint.
ARIZE_OTLP_ENDPOINT=
# PEM file of a collector CA trusted for Arize only.
ARIZE_OTLP_CERTIFICATE=
# Approved model prompt/reply text is opt-in, redacted, and bounded.
NORI_ARIZE_CAPTURE_CONTENT=false

# Web Sentry values (public values are baked into the Next build).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_WEB_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
