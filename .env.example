# Local configuration for both core and web. New project keys belong in root .env.
# Select existing credential files in place; never copy credentials into this example.
# Simple local outer-agent runner. Select the existing credential file with NORI_ENV_FILE.
OPENROUTER_API_KEY=
JEV_API_KEY=
NORI_AGENT_MODEL=anthropic/claude-opus-5.5
NORI_AGENT_BASE_URL=https://openrouter.ai/api/v1
# Server-only web setting; enabled by make dev and ignored in production.
NORI_LOCAL_AGENT_URL=http://127.0.0.1:8080

# Existing GCP runtime uses Application Default Credentials for Vertex AI.
BIND_HOST=127.0.0.1
PORT=8080
NORI_PROJECT_ID=bot-111549
MODEL_LOCATION=global
MODEL_NAME=gemini-3.8-flash
# List price of MODEL_NAME in USD per million tokens; drives the $1 task budget.
MODEL_INPUT_USD_PER_MTOK=0.75
MODEL_OUTPUT_USD_PER_MTOK=3.75
FIRESTORE_DATABASE_ID=nori-poc
ARTIFACT_BUCKET=
COMPUTER_ZONE=
COMPUTER_INSTANCE=nori-computer

# Native Agent Runtime invoke root, ending in /api/.
NORI_RUNTIME_URL=
# /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
IAP_AUDIENCE=
# Optional canonical HTTPS origin for a custom domain.
NORI_APP_ORIGIN=

# Optional path to an existing configuration file when launching from a worktree.
# NORI_ENV_FILE=/absolute/path/to/nori/.env
# Defaults to NORI_ENV_FILE. Select a distinct existing task configuration if needed.
# NORI_TASK_ENV_FILE=/absolute/path/to/nori/.env
# Conversation state and history are durable in the selected Firestore database.
# Hosted mode schedules request-bound processing through this native Cloud Tasks
# queue and same-project OAuth caller. Local mode uses its application loop.
NORI_WAKE_QUEUE=
NORI_WAKE_SERVICE_ACCOUNT=
# Both API entrypoints use the same OpenRouter/Jev outer loop and Temporal tasks.
NORI_EXECUTION_MODE=temporal
# Temporal Cloud: GCP-hosted namespace, TLS with a namespace-scoped API key.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# Optional account-level billing key for the daily spend monitor; separate from namespace execution.
TEMPORAL_BILLING_API_KEY=
# Deployed API alternative: ADC reads this version; takes precedence over the key.
# TEMPORAL_API_KEY_SECRET_VERSION=projects/bot-111549/secrets/nori-temporal-api-key/versions/1
TEMPORAL_TASK_QUEUE=nori-tasks
TEMPORAL_DEPLOYMENT_NAME=nori-task
# Immutable build/release ID; change it for each worker release.
TEMPORAL_BUILD_ID=
# true only for an explicitly local development server (no TLS/API key).
TEMPORAL_LOCAL=false
# Worker image sets this true; leave false for the API and local processes.
TEMPORAL_CLOUD_RUN_ID=false
