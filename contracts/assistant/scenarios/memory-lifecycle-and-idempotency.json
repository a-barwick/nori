{
  "name": "Memory lifecycle, idempotency, tiering, and search",
  "obligation": "Core Memory CRUD, durable mutation receipts, idempotent retries, revision conflicts, pin/unpin/demote/forget, Daily Logs, Working Memory, and global/memory search",
  "note": "Verifies POST/PUT/actions on /v1/memory*, GET /v1/mutations/{request_id}, 409 idempotency and revision conflicts, demotion into /v1/memory/logs, /v1/memory/search, /v1/search memory hits, /v1/memory/working, and owner isolation.",
  "requires": ["memory", "search"],
  "users": {"a": "44444444-4444-4444-8444-444444444444", "b": "55555555-5555-4555-8555-555555555555"},
  "steps": [
    {"name": "create", "user": "a", "method": "POST", "path": "/v1/memory", "body_schema": "library.schema.json#/$defs/MemoryFactChange",
     "body": {"request_id": "${uuid:create}", "expected_revision": 0, "value": {"text": "Prefer UTC ISO-8601 timestamps for zephyr reports.", "about": "the user", "section": "Preferences", "pinned": false}},
     "expect": {"status": [201], "schema": "common.schema.json#/$defs/MutationReceipt", "resource_schema": "library.schema.json#/$defs/MemoryFact", "match": {"/accepted": true, "/status": "applied", "/resource/section": "Preferences", "/resource/provenance": "user_explicit"}},
     "capture": {"id": "/resource/id", "rev1": "/resource/revision"}},
    {"name": "lookup-create", "user": "a", "method": "GET", "path": "/v1/mutations/${uuid:create}",
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/MutationReceipt", "resource_schema": "library.schema.json#/$defs/MemoryFact", "match": {"/request_id": "${uuid:create}", "/resource/id": "${var:id}"}}},
    {"name": "retry-create", "user": "a", "method": "POST", "path": "/v1/memory", "body_schema": "library.schema.json#/$defs/MemoryFactChange",
     "body": {"request_id": "${uuid:create}", "expected_revision": 0, "value": {"text": "Prefer UTC ISO-8601 timestamps for zephyr reports.", "about": "the user", "section": "Preferences", "pinned": false}},
     "expect": {"status": [200, 201], "same_as": "create"}},
    {"name": "conflict-create", "user": "a", "method": "POST", "path": "/v1/memory", "body_schema": "library.schema.json#/$defs/MemoryFactChange",
     "body": {"request_id": "${uuid:create}", "expected_revision": 0, "value": {"text": "Different text reusing create request ID.", "about": "the user", "section": "Preferences"}},
     "expect": {"status": [409], "schema": "common.schema.json#/$defs/APIError", "match": {"/code": "idempotency_conflict", "/accepted": false}, "absent": ["/current"]}},
    {"name": "edit", "user": "a", "method": "PUT", "path": "/v1/memory/${var:id}", "body_schema": "library.schema.json#/$defs/MemoryFactChange",
     "body": {"request_id": "${uuid:edit}", "expected_revision": "${int:rev1}", "value": {"text": "Always use UTC ISO-8601 timestamps for zephyr reports.", "about": "the user", "section": "Preferences"}},
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/MutationReceipt", "resource_schema": "library.schema.json#/$defs/MemoryFact", "match": {"/accepted": true, "/resource/id": "${var:id}", "/resource/text": "Always use UTC ISO-8601 timestamps for zephyr reports."}},
     "capture": {"rev2": "/resource/revision"}},
    {"name": "retry-edit", "user": "a", "method": "PUT", "path": "/v1/memory/${var:id}", "body_schema": "library.schema.json#/$defs/MemoryFactChange",
     "body": {"request_id": "${uuid:edit}", "expected_revision": "${int:rev1}", "value": {"text": "Always use UTC ISO-8601 timestamps for zephyr reports.", "about": "the user", "section": "Preferences"}},
     "expect": {"status": [200], "same_as": "edit"}},
    {"name": "lookup-edit", "user": "a", "method": "GET", "path": "/v1/mutations/${uuid:edit}",
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/MutationReceipt", "match": {"/request_id": "${uuid:edit}", "/resource/revision": "${int:rev2}"}}},
    {"name": "stale-edit", "user": "a", "method": "PUT", "path": "/v1/memory/${var:id}", "body_schema": "library.schema.json#/$defs/MemoryFactChange",
     "body": {"request_id": "${uuid:stale}", "expected_revision": "${int:rev1}", "value": {"text": "Stale edit should conflict.", "about": "the user", "section": "Preferences"}},
     "expect": {"status": [409], "schema": "common.schema.json#/$defs/APIError", "match": {"/code": "revision_conflict", "/current/revision": "${int:rev2}", "/accepted": false}}},
    {"name": "pin", "user": "a", "method": "POST", "path": "/v1/memory/${var:id}/actions", "body_schema": "library.schema.json#/$defs/MemoryAction",
     "body": {"request_id": "${uuid:pin}", "expected_revision": "${int:rev2}", "value": {"action": "pin"}},
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/MutationReceipt", "resource_schema": "library.schema.json#/$defs/MemoryFact", "match": {"/resource/pinned": true}},
     "capture": {"rev3": "/resource/revision"}},
    {"name": "unpin", "user": "a", "method": "POST", "path": "/v1/memory/${var:id}/actions", "body_schema": "library.schema.json#/$defs/MemoryAction",
     "body": {"request_id": "${uuid:unpin}", "expected_revision": "${int:rev3}", "value": {"action": "unpin"}},
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/MutationReceipt", "resource_schema": "library.schema.json#/$defs/MemoryFact", "absent": ["/resource/pinned"]},
     "capture": {"rev4": "/resource/revision"}},
    {"name": "search-memory", "user": "a", "method": "GET", "path": "/v1/memory/search?q=zephyr",
     "expect": {"status": [200], "schema": "library.schema.json#/$defs/MemorySearchResponse", "items_schema": "library.schema.json#/$defs/MemorySearchHit", "match": {"/items/[memory_id=${var:id}]/layer": "core"}}},
    {"name": "search-global", "user": "a", "method": "GET", "path": "/v1/search?q=zephyr",
     "expect": {"status": [200], "schema": "library.schema.json#/$defs/SearchResponse", "items_schema": "library.schema.json#/$defs/SearchHit", "match": {"/items/[id=core:${var:id}]/kind": "memory", "/items/[id=core:${var:id}]/jump/kind": "memory", "/items/[id=core:${var:id}]/jump/layer": "core", "/items/[id=core:${var:id}]/jump/memory_id": "${var:id}"}}},
    {"name": "working-memory", "user": "a", "method": "GET", "path": "/v1/memory/working",
     "expect": {"status": [200], "schema": "library.schema.json#/$defs/WorkingMemory", "match": {"/core_budget_bytes": 24576}}},
    {"name": "owner-isolation", "user": "b", "method": "GET", "path": "/v1/memory",
     "expect": {"status": [200], "items_schema": "library.schema.json#/$defs/MemoryFact", "absent": ["/items/[id=${var:id}]"]}},
    {"name": "demote", "user": "a", "method": "POST", "path": "/v1/memory/${var:id}/actions", "body_schema": "library.schema.json#/$defs/MemoryAction",
     "body": {"request_id": "${uuid:demote}", "expected_revision": "${int:rev4}", "value": {"action": "demote"}},
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/MutationReceipt", "match": {"/accepted": true, "/status": "applied"}}},
    {"name": "logs-list", "user": "a", "method": "GET", "path": "/v1/memory/logs",
     "expect": {"status": [200], "items_schema": "library.schema.json#/$defs/MemoryLog"}},
    {"name": "create-for-forget", "user": "a", "method": "POST", "path": "/v1/memory", "body_schema": "library.schema.json#/$defs/MemoryFactChange",
     "body": {"request_id": "${uuid:create2}", "expected_revision": 0, "value": {"text": "Temporary note to forget.", "about": "the user", "section": "Notes"}},
     "expect": {"status": [201], "schema": "common.schema.json#/$defs/MutationReceipt", "resource_schema": "library.schema.json#/$defs/MemoryFact"},
     "capture": {"id2": "/resource/id", "rev_f": "/resource/revision"}},
    {"name": "forget", "user": "a", "method": "POST", "path": "/v1/memory/${var:id2}/actions", "body_schema": "library.schema.json#/$defs/MemoryAction",
     "body": {"request_id": "${uuid:forget}", "expected_revision": "${int:rev_f}", "value": {"action": "forget"}},
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/MutationReceipt", "match": {"/accepted": true, "/status": "applied", "/resource/forgotten/id": "${var:id2}"}}},
    {"name": "list-after-forget", "user": "a", "method": "GET", "path": "/v1/memory",
     "expect": {"status": [200], "items_schema": "library.schema.json#/$defs/MemoryFact", "absent": ["/items/[id=${var:id2}]"]}}
  ]
}
