{
  "name": "Connection update, retry and conflicts",
  "obligation": "Connection update: revision guard, idempotent retry, conflicting retry",
  "note": "Baseline example 1 with revisions 1 -> 2: retry X returns its original receipt; Y at the old revision conflicts with current; X reused with a changed value is an idempotency conflict without current.",
  "requires": ["connections"],
  "users": {"a": "44444444-4444-4444-8444-444444444444"},
  "steps": [
    {"name": "create", "user": "a", "method": "POST", "path": "/v1/connections", "body_schema": "connections.schema.json#/$defs/ConnectionChange",
     "body": {"request_id": "${uuid:create}", "expected_revision": 0, "value": {"integration_id": "google", "title": "Scenario calendar", "selected_resource_ids": []}},
     "expect": {"status": [201], "schema": "common.schema.json#/$defs/MutationReceipt", "resource_schema": "connections.schema.json#/$defs/Connection", "match": {"/resource/revision": 1}},
     "capture": {"conn": "/resource/id"}},
    {"name": "update-x", "user": "a", "method": "PUT", "path": "/v1/connections/${var:conn}", "body_schema": "connections.schema.json#/$defs/ConnectionChange",
     "body": {"request_id": "${uuid:x}", "expected_revision": 1, "value": {"integration_id": "google", "title": "Renamed by X", "selected_resource_ids": []}},
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/MutationReceipt", "resource_schema": "connections.schema.json#/$defs/Connection", "match": {"/resource/revision": 2, "/resource/title": "Renamed by X"}}},
    {"name": "retry-x", "user": "a", "method": "PUT", "path": "/v1/connections/${var:conn}", "body_schema": "connections.schema.json#/$defs/ConnectionChange",
     "body": {"request_id": "${uuid:x}", "expected_revision": 1, "value": {"integration_id": "google", "title": "Renamed by X", "selected_resource_ids": []}},
     "expect": {"status": [200], "same_as": "update-x"}},
    {"name": "lookup-x", "user": "a", "method": "GET", "path": "/v1/mutations/${uuid:x}",
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/MutationReceipt", "match": {"/request_id": "${uuid:x}", "/resource/revision": 2}}},
    {"name": "stale-y", "user": "a", "method": "PUT", "path": "/v1/connections/${var:conn}", "body_schema": "connections.schema.json#/$defs/ConnectionChange",
     "body": {"request_id": "${uuid:y}", "expected_revision": 1, "value": {"integration_id": "google", "title": "Renamed by Y", "selected_resource_ids": []}},
     "expect": {"status": [409], "schema": "common.schema.json#/$defs/APIError", "match": {"/code": "revision_conflict", "/current/revision": 2, "/accepted": false}}},
    {"name": "x-changed", "user": "a", "method": "PUT", "path": "/v1/connections/${var:conn}", "body_schema": "connections.schema.json#/$defs/ConnectionChange",
     "body": {"request_id": "${uuid:x}", "expected_revision": 1, "value": {"integration_id": "google", "title": "Different title under X", "selected_resource_ids": []}},
     "expect": {"status": [409], "schema": "common.schema.json#/$defs/APIError", "match": {"/code": "idempotency_conflict"}, "absent": ["/current"]}},
    {"name": "unchanged", "user": "a", "method": "GET", "path": "/v1/connections/${var:conn}",
     "expect": {"status": [200], "schema": "connections.schema.json#/$defs/Connection", "match": {"/revision": 2, "/title": "Renamed by X"}}}
  ]
}
