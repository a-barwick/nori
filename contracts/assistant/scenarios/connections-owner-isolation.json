{
  "name": "Connection owner isolation",
  "obligation": "A38 forged identifiers cannot cross ownership",
  "note": "User B uses user A's real connection id and request id on every connection route; each answers 404 and A's connection is unchanged.",
  "requires": ["connections"],
  "users": {"a": "11111111-1111-4111-8111-111111111111", "b": "22222222-2222-4222-8222-222222222222"},
  "steps": [
    {"name": "a-create", "user": "a", "method": "POST", "path": "/v1/connections",
     "body": {"request_id": "${uuid:create}", "expected_revision": 0, "value": {"integration_id": "google", "title": "A's calendar", "selected_resource_ids": []}},
     "expect": {"status": [201]}, "capture": {"conn": "/resource/id"}},
    {"name": "b-read", "user": "b", "method": "GET", "path": "/v1/connections/${var:conn}", "expect": {"status": [404], "match": {"/code": "not_found"}}},
    {"name": "b-resources", "user": "b", "method": "GET", "path": "/v1/connections/${var:conn}/resources", "expect": {"status": [404]}},
    {"name": "b-update", "user": "b", "method": "PUT", "path": "/v1/connections/${var:conn}",
     "body": {"request_id": "${uuid:b1}", "expected_revision": 1, "value": {"integration_id": "google", "title": "taken", "selected_resource_ids": []}}, "expect": {"status": [404]}},
    {"name": "b-disconnect", "user": "b", "method": "POST", "path": "/v1/connections/${var:conn}/actions",
     "body": {"request_id": "${uuid:b2}", "expected_revision": 1, "value": {"action": "disconnect"}}, "expect": {"status": [404]}},
    {"name": "b-receipt", "user": "b", "method": "GET", "path": "/v1/mutations/${uuid:create}", "expect": {"status": [404]}},
    {"name": "b-list", "user": "b", "method": "GET", "path": "/v1/connections", "expect": {"status": [200], "count": {"/items|id=${var:conn}": 0}}},
    {"name": "a-unchanged", "user": "a", "method": "GET", "path": "/v1/connections/${var:conn}", "expect": {"status": [200], "match": {"/revision": 1, "/title": "A's calendar"}}}
  ]
}
