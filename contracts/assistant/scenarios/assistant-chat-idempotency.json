{
  "name": "Assistant chat snapshot, idempotency, conflict, and owner isolation",
  "obligation": "Assistant messages are idempotent on identical retry, reject conflicting text for an existing ID with 409, and isolate user threads across owners",
  "requires": [
    "work"
  ],
  "users": {
    "a": "44444444-4444-4444-8444-444444444444",
    "b": "55555555-5555-4555-8555-555555555555"
  },
  "steps": [
    {
      "name": "a-initial-snapshot",
      "user": "a",
      "method": "GET",
      "path": "/v1/conversations/assistant",
      "expect": {
        "status": [
          200
        ],
        "match": {
          "/id": "assistant",
          "/mode": "assistant",
          "/turnPolicy": "fold_into_turn"
        }
      }
    },
    {
      "name": "a-send-message",
      "user": "a",
      "method": "POST",
      "path": "/v1/conversations/assistant/messages",
      "body": {
        "id": "${uuid:msg}",
        "text": "Check assistant chat idempotency"
      },
      "expect": {
        "status": [
          202
        ],
        "match": {
          "/turnId": "${uuid:msg}",
          "/conversation/id": "assistant",
          "/conversation/messages/[id=${uuid:msg}-user]/text": "Check assistant chat idempotency"
        },
        "count": {
          "/conversation/messages|id=${uuid:msg}-user": 1
        }
      }
    },
    {
      "name": "a-retry-same-message",
      "user": "a",
      "method": "POST",
      "path": "/v1/conversations/assistant/messages",
      "body": {
        "id": "${uuid:msg}",
        "text": "Check assistant chat idempotency"
      },
      "expect": {
        "status": [
          202
        ],
        "match": {
          "/turnId": "${uuid:msg}",
          "/conversation/id": "assistant",
          "/conversation/messages/[id=${uuid:msg}-user]/text": "Check assistant chat idempotency"
        },
        "count": {
          "/conversation/messages|id=${uuid:msg}-user": 1
        }
      }
    },
    {
      "name": "a-conflict-changed-text",
      "user": "a",
      "method": "POST",
      "path": "/v1/conversations/assistant/messages",
      "body": {
        "id": "${uuid:msg}",
        "text": "Different text for same message ID"
      },
      "expect": {
        "status": [
          409
        ]
      }
    },
    {
      "name": "b-snapshot-isolated",
      "user": "b",
      "method": "GET",
      "path": "/v1/conversations/assistant",
      "expect": {
        "status": [
          200
        ],
        "match": {
          "/id": "assistant"
        },
        "count": {
          "/messages|id=${uuid:msg}-user": 0
        }
      }
    },
    {
      "name": "b-same-id-independent",
      "user": "b",
      "method": "POST",
      "path": "/v1/conversations/assistant/messages",
      "body": {
        "id": "${uuid:msg}",
        "text": "User B independent message"
      },
      "expect": {
        "status": [
          202
        ],
        "match": {
          "/turnId": "${uuid:msg}",
          "/conversation/messages/[id=${uuid:msg}-user]/text": "User B independent message"
        },
        "count": {
          "/conversation/messages|id=${uuid:msg}-user": 1
        }
      }
    },
    {
      "name": "a-snapshot-unchanged",
      "user": "a",
      "method": "GET",
      "path": "/v1/conversations/assistant",
      "expect": {
        "status": [
          200
        ],
        "match": {
          "/id": "assistant",
          "/messages/[id=${uuid:msg}-user]/text": "Check assistant chat idempotency"
        },
        "count": {
          "/messages|id=${uuid:msg}-user": 1
        }
      }
    }
  ]
}
