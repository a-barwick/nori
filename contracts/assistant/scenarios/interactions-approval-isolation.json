{
  "name": "Interactions listing, response isolation, and wildcard connection permissions",
  "obligation": "A38/C5: interactions and wildcard connection permission rules are owner-scoped; forged interaction responses return 404 not_found",
  "requires": [
    "interactions",
    "permissions"
  ],
  "users": {
    "a": "44444444-4444-4444-8444-444444444444",
    "b": "55555555-5555-4555-8555-555555555555"
  },
  "steps": [
    {
      "name": "a-list-interactions",
      "user": "a",
      "method": "GET",
      "path": "/v1/interactions",
      "expect": {
        "status": [
          200
        ],
        "schema": "common.schema.json#/$defs/ListResponse",
        "items_schema": "permissions.schema.json#/$defs/Interaction"
      }
    },
    {
      "name": "a-list-pending-interactions",
      "user": "a",
      "method": "GET",
      "path": "/v1/interactions?status=pending",
      "expect": {
        "status": [
          200
        ],
        "schema": "common.schema.json#/$defs/ListResponse",
        "items_schema": "permissions.schema.json#/$defs/Interaction"
      }
    },
    {
      "name": "b-get-forged-interaction",
      "user": "b",
      "method": "GET",
      "path": "/v1/interactions/int_${uuid:missing}",
      "expect": {
        "status": [
          404
        ],
        "schema": "common.schema.json#/$defs/APIError",
        "match": {
          "/code": "not_found",
          "/accepted": false
        }
      }
    },
    {
      "name": "b-respond-forged-interaction",
      "user": "b",
      "method": "POST",
      "path": "/v1/interactions/int_${uuid:missing}/responses",
      "body_schema": "permissions.schema.json#/$defs/InteractionResponse",
      "body": {
        "request_id": "${uuid:bresp}",
        "expected_revision": 1,
        "value": {
          "kind": "approve",
          "action_digest": "sha256:forged"
        }
      },
      "expect": {
        "status": [
          404
        ],
        "schema": "common.schema.json#/$defs/APIError",
        "match": {
          "/code": "not_found",
          "/accepted": false
        }
      }
    },
    {
      "name": "a-create-wildcard-permission",
      "user": "a",
      "method": "POST",
      "path": "/v1/permissions",
      "body_schema": "permissions.schema.json#/$defs/PermissionRuleChange",
      "body": {
        "request_id": "${uuid:wildcard}",
        "expected_revision": 0,
        "value": {
          "effect": "allow",
          "tool_ids": [
            "*"
          ],
          "connection_ids": [
            "*"
          ],
          "resource_ids": [
            "*"
          ],
          "action_classes": [
            "read"
          ],
          "title": "Wildcard connection read rule"
        }
      },
      "expect": {
        "status": [
          201
        ],
        "schema": "common.schema.json#/$defs/MutationReceipt",
        "resource_schema": "permissions.schema.json#/$defs/PermissionRule",
        "match": {
          "/resource/revision": 1,
          "/resource/connection_ids": [
            "*"
          ]
        }
      },
      "capture": {
        "rule": "/resource/id"
      }
    },
    {
      "name": "a-list-permissions",
      "user": "a",
      "method": "GET",
      "path": "/v1/permissions",
      "expect": {
        "status": [
          200
        ],
        "schema": "common.schema.json#/$defs/ListResponse",
        "items_schema": "permissions.schema.json#/$defs/PermissionRule",
        "match": {
          "/items/[id=${var:rule}]/connection_ids": [
            "*"
          ]
        },
        "count": {
          "/items|id=${var:rule}": 1
        }
      }
    },
    {
      "name": "b-list-permissions-isolated",
      "user": "b",
      "method": "GET",
      "path": "/v1/permissions",
      "expect": {
        "status": [
          200
        ],
        "schema": "common.schema.json#/$defs/ListResponse",
        "count": {
          "/items|id=${var:rule}": 0
        }
      }
    },
    {
      "name": "b-read-wildcard-permission",
      "user": "b",
      "method": "GET",
      "path": "/v1/permissions/${var:rule}",
      "expect": {
        "status": [
          404
        ],
        "schema": "common.schema.json#/$defs/APIError",
        "match": {
          "/code": "not_found"
        }
      }
    },
    {
      "name": "a-revoke-wildcard-permission",
      "user": "a",
      "method": "POST",
      "path": "/v1/permissions/${var:rule}/actions",
      "body_schema": "common.schema.json#/$defs/ActionRequest",
      "body": {
        "request_id": "${uuid:revoke}",
        "expected_revision": 1,
        "value": {
          "action": "revoke"
        }
      },
      "expect": {
        "status": [
          200,
          202
        ],
        "schema": "common.schema.json#/$defs/MutationReceipt"
      }
    }
  ]
}
