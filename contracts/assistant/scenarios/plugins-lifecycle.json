{
  "name": "Plugin install, permission-changing update, rollback, pin, uninstall",
  "obligation": "A05 install does not grant authority and contributions are accurate; A06 changed permissions are surfaced and need approval",
  "requires": ["plugins"],
  "users": {"a": "44444444-4444-4444-8444-444444444444", "b": "55555555-5555-4555-8555-555555555555"},
  "steps": [
    {"name": "catalog", "user": "a", "method": "GET", "path": "/v1/plugins/catalog",
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/ListResponse", "items_schema": "plugins.schema.json#/$defs/CatalogEntry", "count": {"/items|latest_version=1.1.0": 1}}},
    {"name": "catalog-entry-shape", "user": "a", "method": "GET", "path": "/v1/plugins/catalog?q=morning",
     "expect": {"status": [200], "match": {"/items/0/package/id": "nori/morning-briefing"}}},
    {"name": "install", "user": "a", "method": "POST", "path": "/v1/plugins/installations", "body_schema": "plugins.schema.json#/$defs/InstallationCreateChange",
     "body": {"request_id": "${uuid:install}", "expected_revision": 0, "value": {"package": {"id": "nori/morning-briefing", "version": "1.0.0"}, "approved_access": {"connection_types": ["google"], "action_classes": ["read"]}}},
     "expect": {"status": [201, 202], "schema": "common.schema.json#/$defs/MutationReceipt", "resource_schema": "plugins.schema.json#/$defs/Installation"},
     "capture": {"inst": "/resource/id"}},
    {"name": "ready", "user": "a", "method": "GET", "path": "/v1/plugins/installations/${var:inst}", "wait": {"pointer": "/state", "value": "ready", "seconds": 20},
     "expect": {"status": [200], "schema": "plugins.schema.json#/$defs/Installation", "match": {"/state": "ready", "/package/version": "1.0.0"}}, "capture": {"rev": "/revision"}},
    {"name": "no-rules-granted", "user": "a", "method": "GET", "path": "/v1/permissions", "expect": {"status": [200], "count": {"/items|title=Morning briefing": 0}}},
    {"name": "b-cannot-see", "user": "b", "method": "GET", "path": "/v1/plugins/installations/${var:inst}", "expect": {"status": [404]}},
    {"name": "review-update", "user": "a", "method": "GET", "path": "/v1/plugins/installations/${var:inst}/review?version=1.1.0",
     "expect": {"status": [200], "schema": "plugins.schema.json#/$defs/InstallationReview", "match": {"/access_added": ["action:reversible_write"]}}},
    {"name": "update-without-consent", "user": "a", "method": "POST", "path": "/v1/plugins/installations/${var:inst}/actions",
     "body": {"request_id": "${uuid:u1}", "expected_revision": "${int:rev}", "value": {"action": "update", "version": "1.1.0"}},
     "expect": {"status": [400, 403, 409], "match": {"/accepted": false}}},
    {"name": "still-1.0.0", "user": "a", "method": "GET", "path": "/v1/plugins/installations/${var:inst}", "expect": {"status": [200], "match": {"/package/version": "1.0.0"}}, "capture": {"rev2": "/revision"}},
    {"name": "update-with-consent", "user": "a", "method": "POST", "path": "/v1/plugins/installations/${var:inst}/actions", "body_schema": "plugins.schema.json#/$defs/InstallationAction",
     "body": {"request_id": "${uuid:u2}", "expected_revision": "${int:rev2}", "value": {"action": "update", "version": "1.1.0", "approved_access": {"connection_types": ["google"], "action_classes": ["read", "reversible_write"]}}},
     "expect": {"status": [200, 202], "schema": "common.schema.json#/$defs/MutationReceipt"}},
    {"name": "updated", "user": "a", "method": "GET", "path": "/v1/plugins/installations/${var:inst}", "wait": {"pointer": "/package/version", "value": "1.1.0", "seconds": 20},
     "expect": {"status": [200], "match": {"/package/version": "1.1.0"}}, "capture": {"rev3": "/revision"}},
    {"name": "rollback", "user": "a", "method": "POST", "path": "/v1/plugins/installations/${var:inst}/actions",
     "body": {"request_id": "${uuid:rb}", "expected_revision": "${int:rev3}", "value": {"action": "rollback", "version": "1.0.0"}},
     "expect": {"status": [200, 202]}},
    {"name": "rolled-back", "user": "a", "method": "GET", "path": "/v1/plugins/installations/${var:inst}", "wait": {"pointer": "/package/version", "value": "1.0.0", "seconds": 20},
     "expect": {"status": [200], "match": {"/package/version": "1.0.0"}}, "capture": {"rev4": "/revision"}},
    {"name": "uninstall", "user": "a", "method": "POST", "path": "/v1/plugins/installations/${var:inst}/actions",
     "body": {"request_id": "${uuid:un}", "expected_revision": "${int:rev4}", "value": {"action": "uninstall"}},
     "expect": {"status": [200, 202]}},
    {"name": "uninstalled", "user": "a", "method": "GET", "path": "/v1/plugins/installations/${var:inst}", "wait": {"pointer": "/enabled", "value": false, "seconds": 20},
     "expect": {"status": [200, 404]}}
  ]
}
