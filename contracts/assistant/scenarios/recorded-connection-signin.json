{
  "name": "Sign-in round trip, repeat, replay and cancel (recorded provider)",
  "obligation": "A02: no phantom or cross-user connection, no duplicate grant, original request can resume",
  "note": "Runs only against a core started with NORI_PROVIDER_REPLAY=contracts/assistant/recordings/google. The callback carries a code the recording accepts; nothing reaches Google.",
  "requires": ["connections", "recorded_provider"],
  "users": {"a": "44444444-4444-4444-8444-444444444444", "b": "55555555-5555-4555-8555-555555555555"},
  "steps": [
    {"name": "create", "user": "a", "method": "POST", "path": "/v1/connections",
     "body": {"request_id": "${uuid:create}", "expected_revision": 0, "value": {"integration_id": "google", "title": "Recorded Google", "selected_resource_ids": []}},
     "expect": {"status": [201], "absent": ["/resource/account"]}, "capture": {"conn": "/resource/id"}},
    {"name": "connect", "user": "a", "method": "POST", "path": "/v1/connections/${var:conn}/actions",
     "body": {"request_id": "${uuid:connect}", "expected_revision": 1, "value": {"action": "connect", "capabilities": ["calendar.read", "calendar.write"], "return_to": "/apps"}},
     "expect": {"status": [202], "schema": "common.schema.json#/$defs/MutationReceipt", "match": {"/status": "queued", "/resource/status": "connecting"}},
     "capture": {"state": "/auth/authorize_url#query:state"}},
    {"name": "b-uses-a-state", "user": "b", "method": "GET", "path": "/v1/connections/oauth/callback?state=${var:state}&code=recorded-code",
     "expect": {"status": [303, 404], "headers": {}}},
    {"name": "a-still-connecting", "user": "a", "method": "GET", "path": "/v1/connections/${var:conn}", "expect": {"status": [200], "match": {"/status": "connecting"}, "absent": ["/account"]}},
    {"name": "callback", "user": "a", "method": "GET", "path": "/v1/connections/oauth/callback?state=${var:state}&code=recorded-code",
     "expect": {"status": [303], "headers": {"Location": "/apps?"}}},
    {"name": "connected", "user": "a", "method": "GET", "path": "/v1/connections/${var:conn}",
     "expect": {"status": [200], "schema": "connections.schema.json#/$defs/Connection", "match": {"/status": "connected", "/account/label": "recorded.user@example.com", "/account/provider_id": "100000000000000000001"}}, "capture": {"rev": "/revision"}},
    {"name": "callback-replayed", "user": "a", "method": "GET", "path": "/v1/connections/oauth/callback?state=${var:state}&code=recorded-code",
     "expect": {"status": [303]}},
    {"name": "still-one-account", "user": "a", "method": "GET", "path": "/v1/connections", "expect": {"status": [200], "count": {"/items|status=connected": 1}}},
    {"name": "b-has-none", "user": "b", "method": "GET", "path": "/v1/connections", "expect": {"status": [200], "count": {"/items|status=connected": 0}}},
    {"name": "resources", "user": "a", "method": "GET", "path": "/v1/connections/${var:conn}/resources", "expect": {"status": [200], "count": {"/items": 2}}},
    {"name": "second", "user": "a", "method": "POST", "path": "/v1/connections",
     "body": {"request_id": "${uuid:create2}", "expected_revision": 0, "value": {"integration_id": "google", "title": "Cancelled Google", "selected_resource_ids": []}},
     "expect": {"status": [201]}, "capture": {"conn2": "/resource/id"}},
    {"name": "connect2", "user": "a", "method": "POST", "path": "/v1/connections/${var:conn2}/actions",
     "body": {"request_id": "${uuid:connect2}", "expected_revision": 1, "value": {"action": "connect", "capabilities": ["calendar.read"], "return_to": "/apps"}},
     "expect": {"status": [202]}, "capture": {"state2": "/auth/authorize_url#query:state"}},
    {"name": "cancel", "user": "a", "method": "GET", "path": "/v1/connections/oauth/callback?state=${var:state2}&error=access_denied",
     "expect": {"status": [303], "headers": {"Location": "result=cancelled"}}},
    {"name": "cancelled-not-connected", "user": "a", "method": "GET", "path": "/v1/connections/${var:conn2}", "expect": {"status": [200], "absent": ["/account"]}},
    {"name": "disconnect", "user": "a", "method": "POST", "path": "/v1/connections/${var:conn}/actions",
     "body": {"request_id": "${uuid:disc}", "expected_revision": "${int:rev}", "value": {"action": "disconnect"}}, "expect": {"status": [200, 202]}},
    {"name": "disconnected", "user": "a", "method": "GET", "path": "/v1/connections/${var:conn}", "wait": {"pointer": "/status", "value": "disconnected", "seconds": 20},
     "expect": {"status": [200], "match": {"/status": "disconnected"}}}
  ]
}
