{
  "name": "Preferences revision guard and account defaults",
  "obligation": "B8: account defaults live in preferences under one revision guard; stale writes conflict with current",
  "requires": ["preferences"],
  "users": {"a": "44444444-4444-4444-8444-444444444444", "b": "55555555-5555-4555-8555-555555555555"},
  "steps": [
    {"name": "read", "user": "a", "method": "GET", "path": "/v1/preferences", "expect": {"status": [200], "schema": "common.schema.json#/$defs/Preferences"}, "capture": {"rev": "/revision"}},
    {"name": "write", "user": "a", "method": "PUT", "path": "/v1/preferences", "body_schema": "common.schema.json#/$defs/PreferencesChange",
     "body": {"request_id": "${uuid:w}", "expected_revision": "${int:rev}", "value": {"timezone": "America/Chicago", "working_hours": [{"day": 1, "start": "09:00", "end": "17:00"}], "default_destination_ids": [], "account_defaults": {}, "budgets": {"task_usd": 1.5}}},
     "expect": {"status": [200], "schema": "common.schema.json#/$defs/MutationReceipt", "resource_schema": "common.schema.json#/$defs/Preferences", "match": {"/resource/timezone": "America/Chicago"}}, "capture": {"rev2": "/resource/revision"}},
    {"name": "stale", "user": "a", "method": "PUT", "path": "/v1/preferences",
     "body": {"request_id": "${uuid:s}", "expected_revision": "${int:rev}", "value": {"timezone": "UTC", "working_hours": [], "default_destination_ids": [], "account_defaults": {}, "budgets": {"task_usd": 1}}},
     "expect": {"status": [409], "match": {"/code": "revision_conflict", "/current/timezone": "America/Chicago"}}},
    {"name": "b-separate", "user": "b", "method": "GET", "path": "/v1/preferences", "expect": {"status": [200], "absent": []}},
    {"name": "foreign-default", "user": "a", "method": "PUT", "path": "/v1/preferences",
     "body": {"request_id": "${uuid:f}", "expected_revision": "${int:rev2}", "value": {"timezone": "America/Chicago", "working_hours": [], "default_destination_ids": [], "account_defaults": {"calendar.create": "conn_00000000000000000000"}, "budgets": {"task_usd": 1}}},
     "expect": {"status": [400, 404], "match": {"/accepted": false}}}
  ]
}
