{
  "exchanges": [
    {
      "name": "insert-run-ok",
      "method": "POST",
      "host": "www.googleapis.com",
      "path": "/calendar/v3/calendars/primary/events",
      "body_contains": [
        "Recorded run"
      ],
      "response": {
        "status": 200,
        "body": {
          "kind": "calendar#event",
          "id": "recordedrun",
          "status": "confirmed",
          "etag": "\"3400000000000009\"",
          "htmlLink": "https://www.google.com/calendar/event?eid=run",
          "summary": "Recorded run",
          "start": {
            "dateTime": "2026-11-12T10:00:00-08:00",
            "timeZone": "America/Los_Angeles"
          },
          "end": {
            "dateTime": "2026-11-12T10:30:00-08:00",
            "timeZone": "America/Los_Angeles"
          },
          "organizer": {
            "email": "recorded.user@example.com",
            "self": true
          },
          "attendees": [
            {
              "email": "guest@example.com",
              "responseStatus": "needsAction"
            }
          ]
        }
      }
    },
    {
      "name": "get-run",
      "method": "GET",
      "host": "www.googleapis.com",
      "path": "/calendar/v3/calendars/primary/events/*",
      "after": [
        "insert-run-ok"
      ],
      "response": {
        "status": 200,
        "body": {
          "kind": "calendar#event",
          "id": "recordedrun",
          "status": "confirmed",
          "etag": "\"3400000000000009\"",
          "htmlLink": "https://www.google.com/calendar/event?eid=run",
          "summary": "Recorded run",
          "start": {
            "dateTime": "2026-11-12T10:00:00-08:00",
            "timeZone": "America/Los_Angeles"
          },
          "end": {
            "dateTime": "2026-11-12T10:30:00-08:00",
            "timeZone": "America/Los_Angeles"
          },
          "organizer": {
            "email": "recorded.user@example.com",
            "self": true
          },
          "attendees": [
            {
              "email": "guest@example.com",
              "responseStatus": "needsAction"
            }
          ]
        }
      }
    },
    {
      "name": "calendar-list",
      "method": "GET",
      "host": "www.googleapis.com",
      "path": "/calendar/v3/users/me/calendarList",
      "response": {
        "status": 200,
        "body": {
          "kind": "calendar#calendarList",
          "items": [
            {
              "kind": "calendar#calendarListEntry",
              "id": "primary",
              "summary": "recorded.user@example.com",
              "timeZone": "America/Los_Angeles",
              "accessRole": "owner",
              "primary": true,
              "selected": true
            },
            {
              "kind": "calendar#calendarListEntry",
              "id": "team.recorded@group.calendar.google.com",
              "summary": "Team",
              "timeZone": "America/Los_Angeles",
              "accessRole": "reader",
              "selected": true
            }
          ]
        }
      }
    },
    {
      "name": "insert-lost",
      "method": "POST",
      "host": "www.googleapis.com",
      "path": "/calendar/v3/calendars/primary/events",
      "times": 1,
      "drop": true,
      "response": {
        "status": 200,
        "body": {}
      }
    },
    {
      "name": "insert-duplicate",
      "method": "POST",
      "host": "www.googleapis.com",
      "path": "/calendar/v3/calendars/primary/events",
      "after": [
        "insert-lost"
      ],
      "response": {
        "status": 409,
        "body": {
          "error": {
            "code": 409,
            "message": "The requested identifier already exists.",
            "errors": [
              {
                "domain": "global",
                "reason": "duplicate",
                "message": "The requested identifier already exists."
              }
            ]
          }
        }
      }
    },
    {
      "name": "get-created",
      "method": "GET",
      "host": "www.googleapis.com",
      "path": "/calendar/v3/calendars/primary/events/*",
      "after": [
        "insert-lost"
      ],
      "response": {
        "status": 200,
        "body": {
          "kind": "calendar#event",
          "id": "recordedcreated",
          "status": "confirmed",
