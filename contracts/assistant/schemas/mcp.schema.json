{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nori.local/assistant/mcp.schema.json",
  "title": "MCP server configuration and discovery (C6)",
  "$defs": {
    "MCPServer": {
      "description": "Configured state plus observed state. Negotiated version and capabilities are observations, not copied claims.",
      "type": "object",
      "required": [
        "id",
        "revision",
        "source",
        "name",
        "transport",
        "enabled",
        "observed"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/Revision"
        },
        "source": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "user"
            }
          },
          "additionalProperties": false
        },
        "name": {
          "type": "string"
        },
        "transport": {
          "enum": [
            "http",
            "stdio"
          ]
        },
        "endpoint": {
          "type": "string"
        },
        "connection_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "enabled": {
          "type": "boolean"
        },
        "exposure": {
          "type": "object",
          "properties": {
            "default": {
              "enum": [
                "direct",
                "discoverable",
                "disabled"
              ]
            },
            "overrides": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "direct",
                  "discoverable",
                  "programmatic",
                  "disabled"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "observed": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "disconnected",
                "connecting",
                "connected",
                "needs_sign_in",
                "failed",
                "disabled"
              ]
            },
            "protocol_version": {
              "type": "string"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "discovery_revision": {
              "type": "string"
            },
            "tool_count": {
              "type": "integer",
              "minimum": 0
            },
            "resource_count": {
              "type": "integer",
              "minimum": 0
            },
            "prompt_count": {
              "type": "integer",
              "minimum": 0
            },
            "last_success_at": {
              "$ref": "common.schema.json#/$defs/Instant"
            },
            "error": {
              "$ref": "common.schema.json#/$defs/ErrorDetail"
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "required": [
                  "at",
                  "level",
                  "message"
                ],
                "properties": {
                  "at": {
                    "$ref": "common.schema.json#/$defs/Instant"
                  },
                  "level": {
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "additionalProperties": false
              },
              "description": "Redacted"
            },
            "credential": {
              "enum": [
                "missing",
                "present"
              ],
              "description": "Whether a configured credential is stored; never its value"
            }
          }
        },
        "auth": {
          "enum": [
            "none",
            "oauth",
            "configured"
          ]
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "token"
            ]
          },
          {
            "required": [
              "api_key"
            ]
          },
          {
            "required": [
              "headers"
            ]
          },
          {
            "required": [
              "credential"
            ]
          }
        ]
      }
    },
    "MCPServerEditable": {
      "type": "object",
      "required": [
        "name",
        "transport",
        "auth",
        "enabled",
        "exposure"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "transport": {
          "enum": [
            "http",
            "stdio"
          ]
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "command_ref": {
          "type": "string",
          "description": "Reference to a declared managed command, not a literal command line"
        },
        "environment_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of secret or configuration references, never literal values"
        },
        "auth": {
          "enum": [
            "none",
            "oauth",
            "configured"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "exposure": {
          "$ref": "#/$defs/MCPServer/properties/exposure"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "endpoint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "stdio"
              }
            }
          },
          "then": {
            "required": [
              "command_ref"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "MCPServerChange": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/Change"
        },
        {
          "properties": {
            "value": {
              "$ref": "#/$defs/MCPServerEditable"
            }
          }
        }
      ]
    },
    "MCPServerAction": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/ActionRequest"
        },
        {
          "properties": {
            "value": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "enum": [
                        "connect",
                        "reconnect",
                        "sign_in",
                        "sign_out",
                        "start",
                        "stop",
                        "restart"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "action",
                    "tool",
                    "exposure"
                  ],
                  "properties": {
                    "action": {
                      "const": "set_exposure"
                    },
                    "tool": {
                      "type": "string",
                      "minLength": 1
                    },
                    "exposure": {
                      "enum": [
                        "direct",
                        "discoverable",
                        "programmatic",
                        "disabled"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      ]
    },
    "MCPServerTool": {
      "type": "object",
      "required": [
        "name",
        "title",
        "exposure",
        "definition",
        "availability"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "exposure": {
          "enum": [
            "direct",
            "discoverable",
            "programmatic",
            "disabled"
          ]
        },
        "definition": {
          "$ref": "common.schema.json#/$defs/DefinitionRef"
        },
        "availability": {
          "$ref": "tools.schema.json#/$defs/AvailableTool/properties/availability"
        }
      }
    },
    "MCPCredentialInput": {
      "description": "POST /v1/mcp/{id}/credential (r2.3). Write-only; the receipt's resource is the MCPServer and never echoes the token. Custody stays behind D1.",
      "type": "object",
      "required": [
        "request_id",
        "token"
      ],
      "properties": {
        "request_id": {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "additionalProperties": false
    }
  }
}
