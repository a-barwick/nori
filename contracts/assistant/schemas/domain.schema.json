{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nori.local/assistant/domain.schema.json",
  "title": "Shared domain shapes: calendar, email, contacts (C8 domain table)",
  "description": "Minimum shared shapes with provider differences preserved. Provider-specific schemas live with their adapters.",
  "$defs": {
    "CalendarTime": {
      "oneOf": [
        {"type": "object", "required": ["kind", "start_date", "end_date"], "properties": {"kind": {"const": "all_day"}, "start_date": {"$ref": "common.schema.json#/$defs/LocalDate"}, "end_date": {"$ref": "common.schema.json#/$defs/LocalDate", "description": "Exclusive"}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "start", "end", "timezone"], "properties": {"kind": {"const": "timed"}, "start": {"$ref": "common.schema.json#/$defs/Instant"}, "end": {"$ref": "common.schema.json#/$defs/Instant"}, "timezone": {"$ref": "common.schema.json#/$defs/Timezone"}}, "additionalProperties": false}
      ]
    },
    "RecurrenceScope": {"enum": ["instance", "following", "series"]},
    "Attendee": {
      "type": "object",
      "required": ["email", "role", "response"],
      "properties": {
        "email": {"type": "string"},
        "name": {"type": "string"},
        "role": {"enum": ["organizer", "required", "optional", "resource"]},
        "response": {"enum": ["accepted", "declined", "tentative", "needs_action", "unknown"]},
        "self": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "CalendarEvent": {
      "type": "object",
      "required": ["ref", "calendar", "title", "time", "supports"],
      "properties": {
        "ref": {"$ref": "common.schema.json#/$defs/ResourceRef", "description": "kind=calendar_event; provider_revision is the provider's concurrency token"},
        "calendar": {"$ref": "common.schema.json#/$defs/ResourceRef", "description": "kind=calendar"},
        "title": {"type": "string"},
        "time": {"$ref": "#/$defs/CalendarTime"},
        "location": {"type": "string"},
        "meeting_url": {"type": "string"},
        "description": {"type": "string"},
        "attendees": {"type": "array", "items": {"$ref": "#/$defs/Attendee"}},
        "recurrence": {"type": "object", "properties": {"rrule": {"type": "string"}, "series_id": {"type": "string"}, "occurrence_id": {"type": "string"}, "exception": {"type": "boolean"}}, "additionalProperties": false},
        "status": {"enum": ["confirmed", "tentative", "cancelled"]},
        "source_url": {"type": "string"},
        "imported_from": {"enum": ["live", "ics"], "description": "An ICS import is not a live account connection"},
        "supports": {"type": "object", "required": ["update", "cancel", "invite", "rsvp", "recurrence_scopes"], "properties": {"update": {"type": "boolean"}, "cancel": {"type": "boolean"}, "invite": {"type": "boolean"}, "rsvp": {"type": "boolean"}, "recurrence_scopes": {"type": "array", "items": {"$ref": "#/$defs/RecurrenceScope"}}}, "additionalProperties": false}
      }
    },
    "AvailabilitySlot": {
      "type": "object",
      "required": ["start", "end", "status"],
      "properties": {
        "start": {"$ref": "common.schema.json#/$defs/Instant"},
        "end": {"$ref": "common.schema.json#/$defs/Instant"},
        "status": {"enum": ["free", "busy", "tentative", "unknown"], "description": "unknown is not free"},
        "sources": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/ResourceRef"}}
      },
      "additionalProperties": false
    },
    "MailAddress": {"type": "object", "required": ["email"], "properties": {"email": {"type": "string"}, "name": {"type": "string"}}, "additionalProperties": false},
    "MailMessage": {
      "type": "object",
      "required": ["ref", "thread", "from", "to", "subject", "received_at", "content"],
      "properties": {
        "ref": {"$ref": "common.schema.json#/$defs/ResourceRef", "description": "kind=mail_message"},
        "thread": {"$ref": "common.schema.json#/$defs/ResourceRef", "description": "kind=mail_thread"},
        "from": {"$ref": "#/$defs/MailAddress"},
        "to": {"type": "array", "items": {"$ref": "#/$defs/MailAddress"}},
        "cc": {"type": "array", "items": {"$ref": "#/$defs/MailAddress"}},
        "subject": {"type": "string"},
        "received_at": {"$ref": "common.schema.json#/$defs/Instant"},
        "content": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["snippet", "full"]}, "text": {"type": "string"}, "result_id": {"type": "string", "description": "Full body stored as a result when large"}}, "additionalProperties": false},
        "attachments": {"type": "array", "items": {"type": "object", "required": ["id", "name", "media_type", "size"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "media_type": {"type": "string"}, "size": {"type": "integer", "minimum": 0}, "upload_id": {"type": "string"}}, "additionalProperties": false}},
        "labels": {"type": "array", "items": {"type": "string"}},
        "folder": {"type": "string"},
        "unread": {"type": "boolean"},
        "source_url": {"type": "string"},
        "supports": {"type": "object", "properties": {"labels": {"type": "boolean"}, "folders": {"type": "boolean"}, "archive": {"type": "boolean"}, "mark_read": {"type": "boolean"}}, "additionalProperties": false}
      }
    },
    "MailDraft": {
      "description": "A draft is not a send. Approval binds exactly these fields via the action digest.",
      "type": "object",
      "required": ["ref", "sender", "to", "cc", "bcc", "subject", "body_text", "attachment_ids"],
      "properties": {
        "ref": {"$ref": "common.schema.json#/$defs/ResourceRef", "description": "kind=mail_draft"},
        "sender": {"$ref": "#/$defs/MailAddress"},
        "to": {"type": "array", "items": {"$ref": "#/$defs/MailAddress"}},
        "cc": {"type": "array", "items": {"$ref": "#/$defs/MailAddress"}},
        "bcc": {"type": "array", "items": {"$ref": "#/$defs/MailAddress"}},
        "subject": {"type": "string"},
        "body_text": {"type": "string"},
        "body_html_result_id": {"type": "string"},
        "attachment_ids": {"type": "array", "items": {"type": "string"}},
        "reply_to": {"$ref": "common.schema.json#/$defs/ResourceRef"},
        "mode": {"enum": ["new", "reply", "reply_all", "forward"]},
        "state": {"enum": ["draft", "sending", "sent", "failed", "uncertain"]},
        "sent_message": {"$ref": "common.schema.json#/$defs/ResourceRef"}
      }
    },
    "ContactCandidate": {
      "type": "object",
      "required": ["source", "name", "emails"],
      "properties": {
        "source": {"$ref": "common.schema.json#/$defs/ResourceRef"},
        "name": {"type": "string"},
        "emails": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "hint": {"type": "string", "description": "Why this candidate, e.g. recent thread; never silently selects"}
      },
      "additionalProperties": false
    }
  }
}
