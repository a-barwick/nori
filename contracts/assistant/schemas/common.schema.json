{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nori.local/assistant/common.schema.json",
  "title": "Nori assistant shared primitives",
  "description": "Baseline r0 encoding of docs/assistant-contract-baseline.md C1 common conventions. Draft: not an accepted contract.",
  "$defs": {
    "ID": {"type": "string", "minLength": 1, "maxLength": 256},
    "UUID": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "Revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "Instant": {"type": "string", "format": "date-time"},
    "LocalDate": {"type": "string", "format": "date"},
    "Timezone": {"type": "string", "minLength": 1, "description": "IANA time zone name"},
    "JSON": {"description": "Any JSON value"},
    "Effect": {"enum": ["read", "reversible_write", "sensitive_send", "unknown", "control"]},
    "Outcome": {
      "description": "Existing operation vocabulary from core/internal/state/evidence.go; not renamed by this baseline.",
      "enum": ["pending", "ready", "attempted", "submitted", "confirmed", "failed", "uncertain", "skipped", "voided"]
    },
    "DefinitionRef": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "Namespaced publisher/package/tool identity"},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1, "description": "Content digest over schema, binding and execution-relevant policy"}
      },
      "additionalProperties": false
    },
    "ResourceRef": {
      "type": "object",
      "required": ["connection_id", "kind", "provider_id"],
      "properties": {
        "connection_id": {"$ref": "#/$defs/ID"},
        "kind": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_revision": {"type": "string"}
      },
      "additionalProperties": false
    },
    "Change": {
      "description": "Create/update request. value is the complete editable value, not a merge patch. Request schemas reject unknown fields.",
      "type": "object",
      "required": ["request_id", "expected_revision", "value"],
      "properties": {
        "request_id": {"$ref": "#/$defs/UUID"},
        "expected_revision": {"$ref": "#/$defs/Revision", "description": "0 for create; current revision otherwise"},
        "value": {"$ref": "#/$defs/JSON"}
      },
      "additionalProperties": false
    },
    "ActionRequest": {
      "description": "Command action (disconnect, pause, run-now, ...). value carries the action's typed parameters.",
      "type": "object",
      "required": ["request_id", "expected_revision", "value"],
      "properties": {
        "request_id": {"$ref": "#/$defs/UUID"},
        "expected_revision": {"$ref": "#/$defs/Revision"},
        "value": {"type": "object"}
      },
      "additionalProperties": false
    },
    "WorkRef": {
      "type": "object",
      "required": ["task_id"],
      "properties": {"task_id": {"type": "string", "minLength": 1}, "operation_id": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "MutationReceipt": {
      "oneOf": [
        {
          "type": "object",
          "required": ["request_id", "accepted", "status", "resource"],
          "properties": {
            "request_id": {"$ref": "#/$defs/UUID"},
            "accepted": {"const": true},
            "status": {"const": "applied"},
            "resource": {"$ref": "#/$defs/JSON"}
          }
        },
        {
          "type": "object",
          "required": ["request_id", "accepted", "status", "resource"],
          "properties": {
            "request_id": {"$ref": "#/$defs/UUID"},
            "accepted": {"const": true},
            "status": {"const": "queued"},
            "resource": {"$ref": "#/$defs/JSON"},
            "work": {"$ref": "#/$defs/WorkRef"}
          }
        }
      ]
    },
    "APIError": {
      "type": "object",
      "required": ["error", "code", "retryable", "accepted"],
      "properties": {
        "error": {"type": "string"},
        "code": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "accepted": {"type": "boolean"},
        "request_id": {"$ref": "#/$defs/UUID"},
        "receipt": {"$ref": "#/$defs/MutationReceipt"}
      }
    },
    "ErrorDetail": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}
    },
    "ListResponse": {
      "type": "object",
      "required": ["items"],
      "properties": {"items": {"type": "array"}, "next_cursor": {"type": "string", "minLength": 1}}
    },
    "Cost": {
      "type": "object",
      "required": ["status"],
      "properties": {"amount_usd": {"type": "number", "minimum": 0}, "status": {"enum": ["known", "unknown", "not_applicable"]}},
      "additionalProperties": false
    }
  }
}
