{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nori.local/assistant/permissions.schema.json",
  "title": "Permission checks and pending interactions (C5)",
  "$defs": {
    "PermissionRule": {
      "description": "Every selector is an explicit allowlist; an empty list matches nothing. Wildcards are explicit values, never implied by absence.",
      "type": "object",
      "required": [
        "id",
        "revision",
        "effect",
        "tool_ids",
        "connection_ids",
        "resource_ids",
        "action_classes"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/Revision"
        },
        "effect": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "tool_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "connection_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ID"
          }
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action_classes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Effect"
          }
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Omitted authorizes nobody for recipient-addressed actions; the explicit wildcard is the string \"*\""
        },
        "automation_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/Instant"
        },
        "max_operations": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/Instant"
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/Instant"
        },
        "goal_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "summary": {
          "type": "string",
          "description": "Server-rendered readable summary of the exact selectors"
        }
      }
    },
    "PermissionRuleEditable": {
      "type": "object",
      "required": [
        "effect",
        "tool_ids",
        "connection_ids",
        "resource_ids",
        "action_classes"
      ],
      "properties": {
        "effect": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "tool_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "connection_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ID"
          }
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action_classes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Effect"
          }
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "automation_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/Instant"
        },
        "max_operations": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "goal_id": {
          "$ref": "common.schema.json#/$defs/ID"
        }
      },
      "additionalProperties": false
    },
    "PermissionRuleChange": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/Change"
        },
        {
          "properties": {
            "value": {
              "$ref": "#/$defs/PermissionRuleEditable"
            }
          }
        }
      ]
    },
    "PermissionDecision": {
      "type": "object",
      "required": [
        "result",
        "reason"
      ],
      "properties": {
        "result": {
          "enum": [
            "allow",
            "deny",
            "needs_interaction"
          ]
        },
        "reason": {
          "type": "string"
        },
        "interaction_id": {
          "$ref": "common.schema.json#/$defs/ID"
        }
      },
      "not": {
        "required": [
          "authority_ref"
        ]
      }
    },
    "QuestionPayload": {
      "type": "object",
      "required": [
        "input"
      ],
      "properties": {
        "input": {
          "enum": [
            "text",
            "choice",
            "multi_choice",
            "date",
            "confirm"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "max_length": {
              "type": "integer",
              "minimum": 1
            },
            "pattern": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ApprovalPayload": {
      "type": "object",
      "required": [
        "summary",
        "effect",
        "account",
        "resources"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "effect": {
          "$ref": "common.schema.json#/$defs/Effect"
        },
        "account": {
          "type": "object",
          "required": [
            "connection_id",
            "label"
          ],
          "properties": {
            "connection_id": {
              "$ref": "common.schema.json#/$defs/ID"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ResourceRef"
          }
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "material_effects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Readable consequences, e.g. attendees will be notified"
        },
        "card": {
          "$ref": "library.schema.json#/$defs/CardPart"
        }
      },
      "additionalProperties": false,
      "description": "The digest lives only on Interaction.action_digest (F10)."
    },
    "AccountSelectionPayload": {
      "type": "object",
      "required": [
        "purpose",
        "eligible_connection_ids"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "eligible_connection_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/ID"
          }
        },
        "remember_as_default": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "SignInPayload": {
      "description": "Server-created sign-in request. For OAuth it carries the authorize URL and expiry; for an app-password integration only where to enter the pair. Never credentials. For an MCP server, integration_id is \"mcp\" and connection_id is the server id.",
      "type": "object",
      "required": [
        "auth",
        "integration_id"
      ],
      "properties": {
        "auth": {
          "enum": [
            "oauth",
            "app_password"
          ]
        },
        "auth_attempt_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "integration_id": {
          "type": "string",
          "minLength": 1
        },
        "connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "The connection, or the MCP server id when integration_id is mcp"
        },
        "authorize_url": {
          "type": "string",
          "format": "uri"
        },
        "requested_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "return_to": {
          "type": "string"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/Instant"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "auth": {
                "const": "oauth"
              }
            }
          },
          "then": {
            "required": [
              "auth_attempt_id",
              "authorize_url",
              "expires_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "auth": {
                "const": "app_password"
              }
            }
          },
          "then": {
            "required": [
              "connection_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "auth_attempt_id"
                  ]
                },
                {
                  "required": [
                    "authorize_url"
                  ]
                },
                {
                  "required": [
                    "expires_at"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "Interaction": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "kind",
        "status",
        "prompt",
        "payload"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/Revision"
        },
        "task_id": {
          "type": "string"
        },
        "instruction_revision": {
          "type": "integer",
          "minimum": 0
        },
        "conversation_id": {
          "type": "string"
        },
        "automation_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "kind": {
          "enum": [
            "question",
            "approval",
            "account_selection",
            "sign_in"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "resolved",
            "expired",
            "superseded"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "payload": {
          "$ref": "common.schema.json#/$defs/JSON"
        },
        "action_digest": {
          "type": "string"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/Instant"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/Instant"
        },
        "resolved_at": {
          "$ref": "common.schema.json#/$defs/Instant"
        },
        "legacy_question_id": {
          "type": "string",
          "description": "Set when this interaction projects an existing state.Question"
        },
        "superseded_by": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "task_title": {
          "type": "string"
        },
        "resolution": {
          "type": "object",
          "required": [
            "kind",
            "at"
          ],
          "properties": {
            "kind": {
              "enum": [
                "answer",
                "approve",
                "decline",
                "choose_account",
                "signed_in",
                "expired"
              ]
            },
            "text": {
              "type": "string"
            },
            "connection_id": {
              "$ref": "common.schema.json#/$defs/ID"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/Instant"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "question"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/QuestionPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "approval"
              }
            }
          },
          "then": {
            "required": [
              "action_digest"
            ],
            "properties": {
              "payload": {
                "$ref": "#/$defs/ApprovalPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "account_selection"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/AccountSelectionPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sign_in"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/SignInPayload"
              }
            }
          }
        }
      ],
      "description": "A task correction supersedes a pending interaction (status superseded, revision+1, superseded_by) in the same transaction that advances the instruction revision, so a response at the old expected_revision is a 409 (I6)."
    },
    "InteractionResponse": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/Change"
        },
        {
          "properties": {
            "value": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "answer"
                    },
                    "text": {
                      "type": "string"
                    },
                    "option_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "action_digest"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "approve",
                        "decline"
                      ]
                    },
                    "action_digest": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "connection_id"
                  ],
                  "properties": {
                    "kind": {
                      "const": "choose_account"
                    },
                    "connection_id": {
                      "$ref": "common.schema.json#/$defs/ID"
                    },
                    "remember_as_default": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "decline"
                    }
                  },
                  "additionalProperties": false,
                  "description": "Not now, for a sign_in interaction; approvals still need the action_digest. signed_in is set by the server when the connection or server becomes usable and is not client-sendable."
                }
              ]
            }
          }
        }
      ]
    }
  }
}
