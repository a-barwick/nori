{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nori.local/assistant/execution.schema.json",
  "title": "Tool executor, pinned invocation and execution records (C4)",
  "description": "Invocation, PreparedAction and AdapterResult are private runtime contracts (x-visibility: private); OperationProjection is the public read shape over the existing OperationRecord.",
  "$defs": {
    "Invocation": {
      "x-visibility": "private",
      "type": "object",
      "required": ["task_id", "instruction_revision", "operation_id", "call_id", "tool", "binding_digest", "arguments_ref", "arguments_digest", "authority_ref"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "instruction_revision": {"type": "integer", "minimum": 0},
        "operation_id": {"type": "string", "minLength": 1},
        "call_id": {"type": "string", "minLength": 1},
        "tool": {"$ref": "common.schema.json#/$defs/DefinitionRef"},
        "binding_digest": {"type": "string", "minLength": 1},
        "connection_id": {"$ref": "common.schema.json#/$defs/ID"},
        "arguments_ref": {"type": "string", "minLength": 1},
        "arguments_digest": {"type": "string", "minLength": 1},
        "authority_ref": {"type": "string", "minLength": 1},
        "parent_operation_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "PreparedAction": {
      "x-visibility": "private",
      "type": "object",
      "required": ["digest", "summary", "effect", "resources"],
      "properties": {
        "digest": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "effect": {"$ref": "common.schema.json#/$defs/Effect"},
        "resources": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/ResourceRef"}},
        "recipients": {"type": "array", "items": {"type": "string"}},
        "provider_precondition": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AdapterResult": {
      "x-visibility": "private",
      "type": "object",
      "required": ["outcome", "content", "result_ids", "provider_refs", "cost"],
      "properties": {
        "outcome": {"enum": ["confirmed", "failed", "submitted", "uncertain"]},
        "content": {"$ref": "common.schema.json#/$defs/JSON"},
        "result_ids": {"type": "array", "items": {"type": "string"}},
        "provider_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/ResourceRef"}},
        "cost": {"$ref": "common.schema.json#/$defs/Cost"},
        "error": {"$ref": "common.schema.json#/$defs/ErrorDetail"}
      },
      "additionalProperties": false
    },
    "OperationProjection": {
      "description": "Public, readable view of an operation. Keeps the existing outcome vocabulary; adds readable account/action summaries. Raw arguments and credentials stay private.",
      "type": "object",
      "required": ["id", "task_id", "instruction_revision", "name", "effect_class", "outcome"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "instruction_revision": {"type": "integer", "minimum": 0},
        "call_id": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "tool": {"$ref": "common.schema.json#/$defs/DefinitionRef"},
        "effect_class": {"$ref": "common.schema.json#/$defs/Effect"},
        "outcome": {"$ref": "common.schema.json#/$defs/Outcome"},
        "cleared": {"enum": ["did_not_run", "read_only", "answered"]},
        "connection_id": {"$ref": "common.schema.json#/$defs/ID"},
        "account_summary": {"type": "string"},
        "action_summary": {"type": "string"},
        "authority_source": {"enum": ["user_request", "permission_rule", "automation", "approval", "internal"]},
        "provider_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/ResourceRef"}},
        "receipt_url": {"type": "string"},
        "result_ids": {"type": "array", "items": {"type": "string"}},
        "parent_operation_id": {"type": "string"},
        "cost": {"$ref": "common.schema.json#/$defs/Cost"},
        "created_at": {"$ref": "common.schema.json#/$defs/Instant"},
        "updated_at": {"$ref": "common.schema.json#/$defs/Instant"},
        "error": {"$ref": "common.schema.json#/$defs/ErrorDetail"}
      },
      "not": {"anyOf": [{"required": ["arguments"]}, {"required": ["credential_ref"]}, {"required": ["authority_ref"]}]}
    }
  }
}
