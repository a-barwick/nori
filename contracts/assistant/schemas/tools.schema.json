{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nori.local/assistant/tools.schema.json",
  "title": "Extension registry and Available tools (C2)",
  "$defs": {
    "Binding": {
      "type": "object",
      "required": [
        "adapter",
        "target",
        "version"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "native",
            "mcp"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Policy": {
      "type": "object",
      "required": [
        "effect",
        "location",
        "retry",
        "timeout_ms"
      ],
      "properties": {
        "effect": {
          "$ref": "common.schema.json#/$defs/Effect"
        },
        "retry": {
          "enum": [
            "safe",
            "provider_key",
            "reconcile_only"
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "location": {
          "enum": [
            "runtime"
          ],
          "description": "Where the call runs"
        },
        "interrupted_cost_usd": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "interrupted_cost_unknown": {
          "type": "boolean",
          "default": false
        },
        "cancellation": {
          "enum": [
            "cooperative",
            "none"
          ]
        }
      },
      "additionalProperties": false
    },
    "ToolDefinition": {
      "type": "object",
      "required": [
        "ref",
        "extension",
        "model_name",
        "title",
        "description",
        "input_schema",
        "binding",
        "policy",
        "exposure"
      ],
      "properties": {
        "ref": {
          "$ref": "common.schema.json#/$defs/DefinitionRef"
        },
        "extension": {
          "$ref": "common.schema.json#/$defs/DefinitionRef"
        },
        "model_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "description": "Model-facing alias (B1: OpenAI rejects '.'). External tools namespace with '__' (gcal__events_list, mcp_<server>__<tool>) plus a short stable hash when over 64. Unique across the effective tool set; built-ins win; collisions are rejected at install (B10)."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "input_schema": {
          "type": "object",
          "description": "Canonical JSON Schema 2020-12 as supplied by the provider"
        },
        "output_schema": {
          "type": "object"
        },
        "model_schema_transform": {
          "type": "string",
          "description": "Recorded version of the model-facing schema projection, when one was applied"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "connection_type": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "exposure": {
          "enum": [
            "direct",
            "discoverable",
            "programmatic",
            "disabled"
          ]
        }
      }
    },
    "AvailableTool": {
      "type": "object",
      "required": [
        "tool",
        "title",
        "description",
        "capability",
        "connection_ids",
        "availability"
      ],
      "properties": {
        "tool": {
          "$ref": "common.schema.json#/$defs/DefinitionRef"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "connection_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ID"
          }
        },
        "availability": {
          "enum": [
            "ready",
            "needs_connection",
            "needs_permission",
            "disabled",
            "unavailable"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "recovery": {
          "enum": [
            "connect",
            "repair",
            "enable",
            "choose_account",
            "request_access"
          ]
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "description": "Stable capability id, e.g. calendar, web_search (B9)"
        },
        "integration_id": {
          "type": "string"
        },
        "effect": {
          "$ref": "common.schema.json#/$defs/Effect"
        },
        "exposure": {
          "enum": [
            "direct",
            "discoverable",
            "programmatic",
            "disabled"
          ]
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "credential_ref"
            ]
          },
          {
            "required": [
              "access_token"
            ]
          },
          {
            "required": [
              "refresh_token"
            ]
          }
        ]
      }
    },
    "AvailableToolList": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/ListResponse"
        },
        {
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AvailableTool"
              }
            }
          }
        }
      ]
    }
  }
}
